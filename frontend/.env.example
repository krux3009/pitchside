# Live FastAPI backend. Used directly in dev, and as the static-miss fallback
# in production (keep it set even when VITE_DATA_URL is on).
VITE_API_URL=http://localhost:8000

# Production-only: serve read pages from the pre-generated static-JSON CDN so the
# frontend never waits on a cold Render instance. Leave UNSET in dev (the app
# then talks straight to VITE_API_URL). No trailing slash — api.js adds the "/".
# Set in Vercel, e.g.:
# VITE_DATA_URL=https://kruxqlyz.com/data
