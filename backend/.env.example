# API-Football key from https://dashboard.api-sports.io
API_FOOTBALL_KEY=

# shared secret protecting /api/internal/refresh (any long random string)
REFRESH_KEY=change-me

# SQLite location (default: backend/app/data/pitchside.db)
DB_PATH=

# CORS origin of the deployed frontend (default: http://localhost:5173)
ALLOWED_ORIGIN=http://localhost:5173
